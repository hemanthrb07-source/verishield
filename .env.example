# VeriShield Environment Configuration
# Copy this file to .env and fill in your values

# ── Security ──────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string
DEBUG=true

# ── API ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verishield
POSTGRES_USER=verishield
POSTGRES_PASSWORD=verishield_secret

# ── Neo4j ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=verishield_neo4j

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── ML Model Paths (optional) ─────────────────────────
DEEPFAKE_MODEL_PATH=ml/models/deepfake/deepfake_detector.pth
FACE_MODEL_PATH=ml/models/face/face_embedder.pth
DOCUMENT_MODEL_PATH=ml/models/document/doc_analyzer.pth
